# Copy to .env on the server (the ops workflow writes it from GitHub secrets).
# Names only here. Never commit real values.

# Pinned n8n image tag, e.g. a version from https://github.com/n8n-io/n8n/releases
N8N_VERSION=
# Public hostname, e.g. n8n.example.com (DNS A record → server)
N8N_HOST=
# Random 32+ chars, generate once (openssl rand -hex 32) and keep it:
# without it, stored credentials cannot be decrypted after a restore.
N8N_ENCRYPTION_KEY=
# Timezone for schedules, e.g. Europe/Berlin
TZ=UTC
